---
title: Ben Court
description: Cardiff based front end developer
---
<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="{{ '/favicon.ico' | url }}" sizes="any">
    <link rel="icon" href="{{ '/favicon-16x16.png' | url }}" type="image/png" sizes="16x16">
    <link rel="icon" href="{{ '/favicon-32x32.png' | url }}" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | url }}">
    <link rel="canonical" href="https://bencourt.co.uk{{ page.url | url }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="https://bencourt.co.uk{{ page.url | url }}">
    <meta name="twitter:card" content="summary">
    <style>
      :root{color-scheme:light dark;--background:light-dark(#fff,#222);--border:light-dark(#000,#181818);--text:light-dark(#333,#fff);--primary:light-dark(#fd2b6c,#fd2b6c);--secondary:light-dark(#029cd0,#ffe641);--link:light-dark(#006b91,#ffe641);--tertiary:light-dark(#ffe641,#029cd0);--footer:light-dark(#e5e5e5,#181818);--heading-font:"Trebuchet MS","Segoe UI",sans-serif;--spacing-md:1rem;--spacing-lg:2rem;--spacing-xl:3rem}*,*::before,*::after{box-sizing:border-box}html,body{font-size:16px;margin:0;min-height:100vh;padding:0}body{background:var(--background);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Oxygen,Ubuntu,Cantarell,"Open Sans","Helvetica Neue",sans-serif;line-height:1.6}::selection{background:var(--secondary);color:#000}h1,h2,h3,h4,h5{color:var(--primary);font-family:var(--heading-font);margin:0;padding:0}h2:not([class]){background:var(--tertiary);color:var(--text);display:inline-block;font-family:var(--heading-font);margin:2rem 0;padding-inline:.5rem;transform:rotate(-3deg)}h2{font-size:1.75rem}h3{font-size:1.5rem;text-wrap:balance}p{line-height:2;margin:0 0 var(--spacing-md);text-wrap:pretty}ul{line-height:2;margin:0 0 var(--spacing-md) var(--spacing-md);padding:0}li::marker{color:var(--primary)}a{color:var(--link)}a:focus-visible,a:hover{filter:hue-rotate(90deg);text-decoration:none}a:focus-visible{outline:2px solid currentColor;outline-offset:2px}.wrapper{display:flex;flex-direction:column;min-height:100vh}.header{align-items:center;background:var(--primary);color:var(--background);display:flex;justify-content:space-between;padding:var(--spacing-md) var(--spacing-lg)}.header h1{color:inherit;margin:0;padding:0}.header a{background:var(--background);color:var(--text);display:block;font-family:var(--heading-font);padding:.5rem .5rem .15rem;text-decoration:none;transform:rotate(-3deg)}.content{flex:1;padding:var(--spacing-lg) var(--spacing-md)}@media (min-width:480px){.content{padding:var(--spacing-lg)}}.footer{background:var(--footer);margin-top:auto;padding:var(--spacing-md) var(--spacing-lg)}.skills{display:flex;flex-wrap:wrap;gap:var(--spacing-md) 1ch;list-style:none;margin:var(--spacing-xl) 0 var(--spacing-lg)}.skills li{font-family:var(--heading-font);padding-inline:.5rem}.skills li:nth-child(odd){background:var(--primary);color:#000;transform:rotate(-3deg)}.skills li:nth-child(even){background:#000;color:var(--primary);transform:rotate(3deg)}.jobs{margin-block-start:var(--spacing-md);margin-inline:var(--spacing-md)}@media (min-width:768px){.jobs{margin-inline:var(--spacing-lg)}}.job{--skills-colour-1:var(--tertiary)}.job+.job{border-top:1px solid var(--border);margin-block-start:var(--spacing-lg);padding-block-start:var(--spacing-lg)}.job summary{display:flex;flex-direction:column;gap:var(--spacing-lg);position:relative}@media (min-width:768px){.job summary{align-items:center;flex-direction:row;justify-content:space-between}}.job__dates{font-size:.875rem;white-space:nowrap}.job__dates time{display:inline-block}.job__dates span{display:inline-block}.job summary::-webkit-details-marker{display:none}
    </style>
  </head>
  <body>
    <div class="wrapper">
      <header class="header">
        <h1>
          <a href="/">Ben Court</a>
        </h1>
        <nav aria-label="Main">
          <a href="/cv">CV</a>
        </nav>
      </header>
      <main class="content">{{ content | safe }}</main>
      <footer class="footer">Made with <a href="https://www.11ty.dev">11ty</a></footer>
    </div>
    
  </body>
</html>
